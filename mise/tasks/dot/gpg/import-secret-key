#!/usr/bin/env bash
#MISE description="Decrypt and import the GPG secret key, and trust it ultimately"
#USAGE arg "<file>" help="Encrypted secret key file"
set -euo pipefail

FINGERPRINT="3AE6F45129EAD69FEC607F7D4E29B67BD34C1F16"

[ -f "$usage_file" ] || { echo "Error: file '$usage_file' not found" >&2; exit 1; }

# Pipe straight into the keyring: no decrypted private key is written to disk
gpg --decrypt "$usage_file" | gpg --allow-secret-key-import --import
# 6 = ultimate trust (same as "trust" -> 5 in gpg --edit-key)
echo "$FINGERPRINT:6:" | gpg --import-ownertrust
