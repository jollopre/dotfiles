#!/bin/bash

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
NOTES_FILE="$SCRIPT_DIR/../var/db/notes.jsonl"

usage() {
  echo "Usage: notes <command> [args]"
  echo ""
  echo "Commands:"
  echo "  add                  Add a new note (interactive)"
  echo "  edit <slug>          Edit a note by slug"
  echo "  list                 List all note titles"
  echo "  search <keyword>     Search notes by keyword"
  echo "  delete <slug>        Delete a note by slug"
}

make_slug() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9 ]//g' | tr ' ' '-' | sed 's/-\+/-/g' | sed 's/^-//;s/-$//'
}

cmd_add() {
  read -rp "Category: " category
  read -rp "Title: "    title
  echo "Content (press Ctrl+D when done):"
  content=$(cat)

  local date slug
  date=$(date +%Y-%m-%d)
  slug=$(make_slug "$title")

  if jq -e --arg s "$slug" 'select(.slug == $s)' "$NOTES_FILE" > /dev/null 2>&1; then
    echo "A note with slug '$slug' already exists."
    exit 1
  fi

  jq -n \
    --arg slug     "$slug" \
    --arg title    "$title" \
    --arg category "$category" \
    --arg date     "$date" \
    --arg content  "$content" \
    '{slug: $slug, title: $title, category: $category, date: $date, content: $content}' \
    >> "$NOTES_FILE"

  echo "Note added (slug: $slug)."
}

cmd_edit() {
  local slug="$1"
  if [[ -z "$slug" ]]; then
    echo "Usage: notes edit <slug>"
    exit 1
  fi

  if ! jq -e --arg s "$slug" 'select(.slug == $s)' "$NOTES_FILE" > /dev/null 2>&1; then
    echo "No note found with slug: $slug"
    exit 1
  fi

  local tmp
  tmp=$(mktemp)

  jq -r --arg s "$slug" 'select(.slug == $s) | .content' "$NOTES_FILE" > "$tmp"

  ${EDITOR:-vi} "$tmp"

  local new_content tmp_jsonl
  new_content=$(cat "$tmp")
  rm "$tmp"

  tmp_jsonl=$(mktemp)
  jq --arg s "$slug" --arg c "$new_content" \
    'if .slug == $s then .content = $c else . end' \
    "$NOTES_FILE" > "$tmp_jsonl" && mv "$tmp_jsonl" "$NOTES_FILE"

  echo "Note updated."
}

cmd_list() {
  jq -r '"  [" + .category + "] " + .title + " (" + .slug + ")"' "$NOTES_FILE"
}

cmd_search() {
  local keyword="$1"
  if [[ -z "$keyword" ]]; then
    echo "Usage: notes search <keyword>"
    exit 1
  fi

  jq -r --arg kw "$keyword" \
    'select(
      (.title | test($kw; "i")) or
      (.slug | test($kw; "i")) or
      (.content | test($kw; "i")) or
      (.category | test($kw; "i"))
    ) | "[" + .category + "] " + .title + " (" + .slug + ")\n" + .content + "\n---"' \
    "$NOTES_FILE"
}

cmd_delete() {
  local slug="$1"
  if [[ -z "$slug" ]]; then
    echo "Usage: notes delete <slug>"
    exit 1
  fi

  if ! jq -e --arg s "$slug" 'select(.slug == $s)' "$NOTES_FILE" > /dev/null 2>&1; then
    echo "No note found with slug: $slug"
    exit 1
  fi

  local tmp_jsonl
  tmp_jsonl=$(mktemp)

  jq --arg s "$slug" 'select(.slug != $s)' "$NOTES_FILE" > "$tmp_jsonl" \
    && mv "$tmp_jsonl" "$NOTES_FILE"

  echo "Note deleted."
}

case "$1" in
  add)    cmd_add ;;
  edit)   cmd_edit "$2" ;;
  list)   cmd_list ;;
  search) cmd_search "$2" ;;
  delete) cmd_delete "$2" ;;
  *)      usage ;;
esac
